# Copie para secrets.toml SOMENTE no seu computador; na nuvem, use Settings > Secrets.
# Use os valores de Connect > Session pooler do seu projeto Supabase.
[database]
host = "COPIE_O_HOST_DO_SESSION_POOLER"
port = 5432
dbname = "postgres"
user = "postgres.SUA_REFERENCIA_DO_PROJETO"
password = "CONFIGURE_APENAS_NO_ARQUIVO_LOCAL_OU_NO_PAINEL_DE_SECRETS"
